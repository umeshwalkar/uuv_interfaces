// SYNCED COPY -- sourced from xl300-dds-v2/idl/health.idl. Do NOT edit directly:
// fix in xl300-dds-v2, then re-sync (see ../README.md).
#include "common.idl"

// Universal health vocabulary + heartbeat. Every sensor manager and every subsystem
// publishes exactly one Heartbeat on `health/<node>` -- this is the fleet-wide failure
// detector (SES arms DDS's on_deadline_missed on the HEALTH QoS profile; a missed
// deadline *is* the failure signal, no polling, no broker).
module xl300
{
    // Matches xl300-messaging SCHEMA.md's uniform `health` enum exactly:
    // "ok" | "degraded" | "disconnected" | "error" | "disabled". HEALTH_ prefix avoids
    // fastddsgen's unscoped-enum collision with common.idl's NavIntegrity (NAV_*).
    enum HealthState
    {
        HEALTH_OK,
        HEALTH_DEGRADED,
        HEALTH_DISCONNECTED,
        HEALTH_ERROR,
        HEALTH_DISABLED
    };

    @extensibility(APPENDABLE)
    struct Heartbeat
    {
        CommonHeader   header;
        @key string<32> node;       // e.g. "nss", "ins_manager", "mnss", "ses", "css"
        HealthState    status;
        unsigned long  seq;
        long           data_age_ms; // -1 when not applicable/never received (matches MQTT's null -> -1 sentinel convention)
    };
};
