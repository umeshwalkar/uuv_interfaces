<!-- SYNCED COPY -- sourced from xl300-dds-v2/qos/xl300_profiles.xml. Do NOT edit
     directly: fix in xl300-dds-v2, then re-sync (see ../README.md). -->
<!-- XL300 v2 Fast-DDS QoS profiles -- the named profiles from DDS_Topic_Contract.md §5.
     Apply by setting  FASTRTPS_DEFAULT_PROFILES_FILE=/etc/xl300/xl300_profiles.xml
     then create entities BY PROFILE NAME in code (see ../USER_GUIDE.md).

     IMPORTANT (RxO rule): a DataWriter and DataReader only connect if their QoS are
     COMPATIBLE (reader's request <= writer's offer). Keep each topic's writer+reader
     on the matching profile below or they silently won't communicate -- see
     ../DDS_Topic_Contract.md's troubleshooting note.

     Single domain (10) -- see dds_domain.yaml and DDS_Topic_Contract.md §2 for why this
     package uses one domain + partitions instead of a multi-domain split.

     data_sharing=OFF on every profile: Fast-DDS's Data Sharing feature (zero-copy via
     /dev/shm) auto-negotiates whenever two participants' GUID prefixes look like the
     "same host" -- if sensor managers and consumers ever run in separate containers with
     isolated /dev/shm (each its own devcontainer/compose service), one participant can
     advertise a shm segment the other can never open. Turning it off costs nothing on a
     single real host and avoids that failure mode in every containerized dev/test setup. -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>

    <!-- ================= PARTICIPANT (Domain 10) ================================
         SIMPLE discovery (multicast) -- zero config, works on a LAN and in the dev
         lab. Move to a Discovery Server (commented block at the bottom) once the
         fleet grows enough that SPDP multicast chatter becomes a real cost. -->
    <participant profile_name="xl300_domain10" is_default_profile="true">
      <domainId>10</domainId>
      <rtps>
        <builtin>
          <discovery_config>
            <discoveryProtocol>SIMPLE</discoveryProtocol>
          </discovery_config>
          <!-- Unicast bootstrap alongside multicast: on some container network setups
               (e.g. Docker Desktop --network=host) SPDP multicast does not reliably
               cross container boundaries even on one host. Adding 127.0.0.1 as an
               initial peer makes Fast-DDS also announce via unicast, which reaches
               every co-located participant regardless. Harmless on a real LAN
               (multicast still runs too); this only ADDS a bootstrap path. -->
          <initialPeersList>
            <locator>
              <udpv4>
                <address>127.0.0.1</address>
              </udpv4>
            </locator>
          </initialPeersList>
        </builtin>
      </rtps>
    </participant>

    <!-- ================= DATA WRITER PROFILES ================================== -->

    <!-- STATE: latest-value fused streams (nav/core, feedback/*). RELIABLE, EXCLUSIVE
         so a redundant publisher (if one is ever added) fails over with zero
         subscriber-side logic -- see ownership_strength note in USER_GUIDE.md. -->
    <data_writer profile_name="STATE">
      <qos>
        <reliability><kind>RELIABLE</kind></reliability>
        <durability><kind>VOLATILE</kind></durability>
        <ownership><kind>EXCLUSIVE</kind></ownership>
        <deadline><period><sec>0</sec><nanosec>40000000</nanosec></period></deadline>
        <data_sharing><kind>OFF</kind></data_sharing>
      </qos>
      <topic><historyQos><kind>KEEP_LAST</kind><depth>1</depth></historyQos></topic>
    </data_writer>

    <!-- CONTROL: commands (ctrl/*, power/cmd). RELIABLE + TRANSIENT_LOCAL + EXCLUSIVE.
         announcement_period MUST be < lease_duration (DDS liveliness QoS invariant) --
         set to lease_duration/3 so one lost announcement doesn't expire the lease. -->
    <data_writer profile_name="CONTROL">
      <qos>
        <reliability><kind>RELIABLE</kind></reliability>
        <durability><kind>TRANSIENT_LOCAL</kind></durability>
        <ownership><kind>EXCLUSIVE</kind></ownership>
        <deadline><period><sec>0</sec><nanosec>40000000</nanosec></period></deadline>
        <liveliness><kind>AUTOMATIC</kind><lease_duration><sec>0</sec><nanosec>200000000</nanosec></lease_duration><announcement_period><sec>0</sec><nanosec>60000000</nanosec></announcement_period></liveliness>
        <data_sharing><kind>OFF</kind></data_sharing>
      </qos>
      <topic><historyQos><kind>KEEP_LAST</kind><depth>1</depth></historyQos></topic>
    </data_writer>

    <!-- SAFETY: safety/state, safety/abort. RELIABLE + TRANSIENT_LOCAL (late-joining
         actuator immediately learns current safe-state) + EXCLUSIVE. -->
    <data_writer profile_name="SAFETY">
      <qos>
        <reliability><kind>RELIABLE</kind></reliability>
        <durability><kind>TRANSIENT_LOCAL</kind></durability>
        <ownership><kind>EXCLUSIVE</kind></ownership>
        <deadline><period><sec>0</sec><nanosec>50000000</nanosec></period></deadline>
        <liveliness><kind>AUTOMATIC</kind><lease_duration><sec>0</sec><nanosec>100000000</nanosec></lease_duration><announcement_period><sec>0</sec><nanosec>30000000</nanosec></announcement_period></liveliness>
        <data_sharing><kind>OFF</kind></data_sharing>
      </qos>
      <topic><historyQos><kind>KEEP_LAST</kind><depth>1</depth></historyQos></topic>
    </data_writer>

    <!-- SENSOR: raw high-rate adaptor streams (sensors/*). BEST_EFFORT -- a stale
         sample is useless, no point retransmitting it. SHARED ownership: no
         redundancy/failover semantics needed for a raw sensor feed. -->
    <data_writer profile_name="SENSOR">
      <qos>
        <reliability><kind>BEST_EFFORT</kind></reliability>
        <durability><kind>VOLATILE</kind></durability>
        <ownership><kind>SHARED</kind></ownership>
        <data_sharing><kind>OFF</kind></data_sharing>
      </qos>
      <topic><historyQos><kind>KEEP_LAST</kind><depth>1</depth></historyQos></topic>
    </data_writer>

    <!-- HEALTH: heartbeats (health/<node>). BEST_EFFORT + deadline = failure
         detector -- SES arms on_deadline_missed; a miss IS the failure signal. -->
    <data_writer profile_name="HEALTH">
      <qos>
        <reliability><kind>BEST_EFFORT</kind></reliability>
        <durability><kind>VOLATILE</kind></durability>
        <ownership><kind>SHARED</kind></ownership>
        <deadline><period><sec>1</sec><nanosec>0</nanosec></period></deadline>
        <data_sharing><kind>OFF</kind></data_sharing>
      </qos>
      <topic><historyQos><kind>KEEP_LAST</kind><depth>1</depth></historyQos></topic>
    </data_writer>

    <!-- PAYLOAD: high-bandwidth mission-sensor streams (payload/eoir frame_info,
         payload/fls, payload/sss, payload/tas -- the metadata only, see
         future_sensors.idl). BEST_EFFORT, KEEP_LAST(2) so a consumer that missed one
         frame still has the previous one instead of nothing. -->
    <data_writer profile_name="PAYLOAD">
      <qos>
        <reliability><kind>BEST_EFFORT</kind></reliability>
        <durability><kind>VOLATILE</kind></durability>
        <ownership><kind>SHARED</kind></ownership>
        <data_sharing><kind>OFF</kind></data_sharing>
      </qos>
      <topic><historyQos><kind>KEEP_LAST</kind><depth>2</depth></historyQos></topic>
    </data_writer>

    <!-- MISSION: mission plans/commands (mission/payload/cmd). RELIABLE +
         TRANSIENT_LOCAL + EXCLUSIVE -- infrequent, but must arrive, and a
         late-joining MPS must see the last command issued. -->
    <data_writer profile_name="MISSION">
      <qos>
        <reliability><kind>RELIABLE</kind></reliability>
        <durability><kind>TRANSIENT_LOCAL</kind></durability>
        <ownership><kind>EXCLUSIVE</kind></ownership>
        <data_sharing><kind>OFF</kind></data_sharing>
      </qos>
      <topic><historyQos><kind>KEEP_LAST</kind><depth>8</depth></historyQos></topic>
    </data_writer>

    <!-- LOG: DLS recorder taps. RELIABLE + KEEP_ALL -- the recorder must not miss a
         sample; VOLATILE because durability for a log stream is TimescaleDB itself,
         not DDS. Only DLS should ever create a writer on this profile in practice
         (it's a read-only recorder), but the profile is writer+reader symmetric. -->
    <data_writer profile_name="LOG">
      <qos>
        <reliability><kind>RELIABLE</kind></reliability>
        <durability><kind>VOLATILE</kind></durability>
        <ownership><kind>SHARED</kind></ownership>
        <data_sharing><kind>OFF</kind></data_sharing>
      </qos>
      <topic><historyQos><kind>KEEP_ALL</kind></historyQos></topic>
    </data_writer>

    <!-- ================= DATA READER PROFILES (mirror the writers) ============= -->
    <data_reader profile_name="STATE">
      <qos>
        <reliability><kind>RELIABLE</kind></reliability>
        <durability><kind>VOLATILE</kind></durability>
        <ownership><kind>EXCLUSIVE</kind></ownership>
        <deadline><period><sec>0</sec><nanosec>40000000</nanosec></period></deadline>
        <data_sharing><kind>OFF</kind></data_sharing>
      </qos>
      <topic><historyQos><kind>KEEP_LAST</kind><depth>1</depth></historyQos></topic>
    </data_reader>

    <data_reader profile_name="CONTROL">
      <qos>
        <reliability><kind>RELIABLE</kind></reliability>
        <durability><kind>TRANSIENT_LOCAL</kind></durability>
        <ownership><kind>EXCLUSIVE</kind></ownership>
        <deadline><period><sec>0</sec><nanosec>40000000</nanosec></period></deadline>
        <liveliness><kind>AUTOMATIC</kind><lease_duration><sec>0</sec><nanosec>200000000</nanosec></lease_duration><announcement_period><sec>0</sec><nanosec>60000000</nanosec></announcement_period></liveliness>
        <data_sharing><kind>OFF</kind></data_sharing>
      </qos>
      <topic><historyQos><kind>KEEP_LAST</kind><depth>1</depth></historyQos></topic>
    </data_reader>

    <data_reader profile_name="SAFETY">
      <qos>
        <reliability><kind>RELIABLE</kind></reliability>
        <durability><kind>TRANSIENT_LOCAL</kind></durability>
        <ownership><kind>EXCLUSIVE</kind></ownership>
        <deadline><period><sec>0</sec><nanosec>50000000</nanosec></period></deadline>
        <liveliness><kind>AUTOMATIC</kind><lease_duration><sec>0</sec><nanosec>100000000</nanosec></lease_duration><announcement_period><sec>0</sec><nanosec>30000000</nanosec></announcement_period></liveliness>
        <data_sharing><kind>OFF</kind></data_sharing>
      </qos>
      <topic><historyQos><kind>KEEP_LAST</kind><depth>1</depth></historyQos></topic>
    </data_reader>

    <data_reader profile_name="SENSOR">
      <qos>
        <reliability><kind>BEST_EFFORT</kind></reliability>
        <durability><kind>VOLATILE</kind></durability>
        <data_sharing><kind>OFF</kind></data_sharing>
      </qos>
      <topic><historyQos><kind>KEEP_LAST</kind><depth>1</depth></historyQos></topic>
    </data_reader>

    <data_reader profile_name="HEALTH">
      <qos>
        <reliability><kind>BEST_EFFORT</kind></reliability>
        <durability><kind>VOLATILE</kind></durability>
        <deadline><period><sec>1</sec><nanosec>0</nanosec></period></deadline>
        <data_sharing><kind>OFF</kind></data_sharing>
      </qos>
      <topic><historyQos><kind>KEEP_LAST</kind><depth>1</depth></historyQos></topic>
    </data_reader>

    <data_reader profile_name="PAYLOAD">
      <qos>
        <reliability><kind>BEST_EFFORT</kind></reliability>
        <durability><kind>VOLATILE</kind></durability>
        <data_sharing><kind>OFF</kind></data_sharing>
      </qos>
      <topic><historyQos><kind>KEEP_LAST</kind><depth>2</depth></historyQos></topic>
    </data_reader>

    <data_reader profile_name="MISSION">
      <qos>
        <reliability><kind>RELIABLE</kind></reliability>
        <durability><kind>TRANSIENT_LOCAL</kind></durability>
        <ownership><kind>EXCLUSIVE</kind></ownership>
        <data_sharing><kind>OFF</kind></data_sharing>
      </qos>
      <topic><historyQos><kind>KEEP_LAST</kind><depth>8</depth></historyQos></topic>
    </data_reader>

    <data_reader profile_name="LOG">
      <qos>
        <reliability><kind>RELIABLE</kind></reliability>
        <durability><kind>VOLATILE</kind></durability>
        <data_sharing><kind>OFF</kind></data_sharing>
      </qos>
      <topic><historyQos><kind>KEEP_ALL</kind></historyQos></topic>
    </data_reader>

    <!-- ============ OPTIONAL: Discovery Server (enable later for scale) =========
    Replace the SIMPLE participant above with this CLIENT one once the fleet has
    enough participants that SPDP multicast discovery chatter becomes a real cost.
    Run 1-2 discovery servers (redundant) on stable hosts, e.g.:
      fastdds discovery -i 0 -l 192.168.10.11 -p 11811   (nav_pc)
    <participant profile_name="xl300_domain10" is_default_profile="true">
      <domainId>10</domainId>
      <rtps><builtin><discovery_config>
        <discoveryProtocol>CLIENT</discoveryProtocol>
        <discoveryServersList>
          <RemoteServer prefix="44.53.00.5f.45.50.52.4f.53.49.4d.41">
            <metatrafficUnicastLocatorList>
              <locator><udpv4><address>192.168.10.11</address><port>11811</port></udpv4></locator>
            </metatrafficUnicastLocatorList>
          </RemoteServer>
        </discoveryServersList>
      </discovery_config></builtin></rtps>
    </participant>
    ========================================================================== -->

  </profiles>
</dds>
