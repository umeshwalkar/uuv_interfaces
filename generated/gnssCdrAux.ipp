        << eprosima::fastcdr::MemberId(1) << data.device_id()
        << eprosima::fastcdr::MemberId(2) << data.device_name()
        << eprosima::fastcdr::MemberId(3) << data.valid()
        << eprosima::fastcdr::MemberId(4) << data.gga()
        << eprosima::fastcdr::MemberId(5) << data.zda()
        << eprosima::fastcdr::MemberId(6) << data.rmc()
        << eprosima::fastcdr::MemberId(7) << data.vtg()
        << eprosima::fastcdr::MemberId(8) << data.heading()
;
    scdr.end_serialize_type(current_state);
}

template<>
eProsima_user_DllExport void deserialize(
        eprosima::fastcdr::Cdr& cdr,
        xl300::GnssFix& data)
{
    using namespace xl300;

    cdr.deserialize_type(eprosima::fastcdr::CdrVersion::XCDRv2 == cdr.get_cdr_version() ?
            eprosima::fastcdr::EncodingAlgorithmFlag::DELIMIT_CDR2 :
            eprosima::fastcdr::EncodingAlgorithmFlag::PLAIN_CDR,
            [&data](eprosima::fastcdr::Cdr& dcdr, const eprosima::fastcdr::MemberId& mid) -> bool
            {
                bool ret_value = true;
                switch (mid.id)
                {
                                        case 0:
                                                dcdr >> data.header();
                                            break;

                                        case 1:
                                                dcdr >> data.device_id();
                                            break;

                                        case 2:
                                                dcdr >> data.device_name();
                                            break;

                                        case 3:
                                                dcdr >> data.valid();
                                            break;

                                        case 4:
                                                dcdr >> data.gga();
                                            break;

                                        case 5:
                                                dcdr >> data.zda();
                                            break;

                                        case 6:
                                                dcdr >> data.rmc();
                                            break;

                                        case 7:
                                                dcdr >> data.vtg();
                                            break;

                                        case 8:
                                                dcdr >> data.heading();
                                            break;

                    default:
                        ret_value = false;
                        break;
                }
                return ret_value;
            });
}

void serialize_key(
        eprosima::fastcdr::Cdr& scdr,
        const xl300::GnssFix& data)
{
    using namespace xl300;

    static_cast<void>(scdr);
    static_cast<void>(data);
}




